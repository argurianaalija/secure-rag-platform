# Copy this file to `.env` and adjust the values.

# Maximum allowed size for a PDF (in megabytes)
MAX_UPLOAD_SIZE_MB=25

# Folder where uploaded files are stored
UPLOAD_DIR=uploads

# Environment: development | production
ENVIRONMENT=development

# Chunking (Week 2)
# Size of each text block (in characters)
CHUNK_SIZE_CHARS=1000
# Overlap characters between a block and the next
CHUNK_OVERLAP_CHARS=200

# Vector database and embeddings (Week 3)
DATABASE_URL=postgresql://postgres:ragpass@localhost:5433/ragdb
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SEARCH_TOP_K=5
